# Copy this file to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./data/wellfarm.sqlite
UPLOAD_DIRECTORY=./data/uploads
DEFAULT_LOCALE=en-IN
DEMO_MODE=true

# Add these after choosing the free LLM provider.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
