# Copy this file to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173
APP_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
DATABASE_PATH=./data/wellfarm.sqlite
UPLOAD_DIRECTORY=./data/uploads
DEFAULT_LOCALE=en-IN
AUTH_PROVIDER=local
SUPABASE_PROJECT_MODE=dedicated
# Set AUTH_PROVIDER=supabase only after completing docs/supabase-auth-setup.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for dedicated-project account administration, private
# scan records, crop-photo Storage, and saved model results.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only token from https://supabase.com/dashboard/account/tokens.
# Required only when running `npm run auth:configure-email`.
SUPABASE_ACCESS_TOKEN=
# Resend SMTP uses an API key as its password. Keep it server-only.
RESEND_API_KEY=
# Must belong to a domain verified in Resend; do not use a free mailbox address.
AUTH_EMAIL_FROM=no-reply@auth.example.com
AUTH_EMAIL_SENDER_NAME=Wellfarm
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional comma-separated hostname allowlist. Defaults to APP_ORIGIN's hostname.
TURNSTILE_ALLOWED_HOSTNAMES=localhost
GOOGLE_AUTH_ENABLED=false
APP_ORIGIN=http://localhost:5173
WELLFARM_ADMIN_EMAIL=shivamrtamboli62@gmail.com

# Optional free-tier explanation layer. The app works without this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Production crop-image inference. The release manifest contains the default
# free GitHub-hosted artifact URL and its checksum; either value can be overridden.
VISION_RUNTIME=onnx
VISION_MODEL_URL=
VISION_MODEL_SHA256=
VISION_MODEL_CACHE_DIRECTORY=
# Server-only fine-grained GitHub token with read-only Contents access to this
# private repository. Required for the default private release download.
VISION_MODEL_AUTH_TOKEN=
VITE_API_URL=
