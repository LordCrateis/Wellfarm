# Copy this file to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./data/wellfarm.sqlite
UPLOAD_DIRECTORY=./data/uploads
DEFAULT_LOCALE=en-IN
AUTH_PROVIDER=local
SUPABASE_PROJECT_MODE=shared
# Set AUTH_PROVIDER=supabase only after completing docs/supabase-auth-setup.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SITE_KEY=
GOOGLE_AUTH_ENABLED=false
APP_ORIGIN=http://localhost:5173
WELLFARM_ADMIN_EMAIL=shivamrtamboli62@gmail.com

# Optional free-tier explanation layer. The app works without this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
